# Copy this file to .env.local (same folder) and fill in values.
# .env.local is gitignored — never commit real keys.

# --- Required for AI generation (pick at least one) ---
# Primary provider used by ByteLab/ByteVerse (recommended)
TOGETHER_API_KEY=

# Fallback providers (optional; auto-selected if Together is missing)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- FreeLLMAPI (OpenAI-compatible multi-provider proxy) ---
# Run locally: https://github.com/tashfeenahmed/freellmapi
# FREELLMAPI_BASE_URL=http://localhost:3001/v1
# FREELLMAPI_API_KEY=freellmapi-your-unified-key

# --- Local LLM (Ollama) ---
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Additional cloud providers (OpenAI-compatible) ---
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# GOOGLE_AI_API_KEY=

# --- Auth & cloud storage (required for sign-in and cloud projects) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — from Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated admin emails for /admin panel access
# ADMIN_EMAILS=you@byteverse.app

# Password reset / signup / magic-link emails use ByteVerse-branded Supabase Auth templates.
# Setup guide: apps/web/docs/AUTH_EMAIL_SETUP.md
#
# Deploy templates: node scripts/configure-auth-email.mjs
# Deploy + SMTP:    node scripts/configure-auth-email.mjs --smtp
# Verify:            node scripts/verify-auth-email.mjs
#
# Add these redirect URLs in Supabase Dashboard → Authentication → URL Configuration:
#   http://localhost:3000/auth/callback
#   http://localhost:3000/auth/confirm
#   https://byteverse.app/auth/callback
#   https://byteverse.app/auth/confirm
#
# Resend SMTP (server-side only — set in .env.local, configure via --smtp script):
# RESEND_SMTP_PASSWORD=
# AUTH_SMTP_FROM_EMAIL=noreply@auth.byteverse.app
# SUPABASE_ACCESS_TOKEN=   # from https://supabase.com/dashboard/account/tokens

# --- Media search in editor (all optional) ---
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
GIPHY_API_KEY=

# Rate limits (optional defaults exist)
GOOGLE_SEARCH_MAX_QUERIES_PER_DAY=100
GOOGLE_SEARCH_MAX_QUERIES_PER_HOUR=30
GOOGLE_SEARCH_MAX_QUERIES_PER_MINUTE=10
MAX_SEARCHES_PER_VALIDATION=5

# --- Optional: security scripts (scripts/security-smoke-test.mjs) ---
# SMOKE_TEST_EMAIL=
# SMOKE_TEST_PASSWORD=
# SUPABASE_ACCESS_TOKEN=   # from https://supabase.com/dashboard/account/tokens (configure-auth-signup.mjs, enable-hibp.mjs)

# --- Marketing (optional) ---
NEXT_PUBLIC_FORMSPREE_ID=
