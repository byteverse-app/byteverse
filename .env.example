# ByteVerse secrets live in the Next.js app, not the repo root.
#
# 1. Copy the template:
#    copy apps\web\.env.example apps\web\.env.local
#
# 2. Edit apps\web\.env.local and set at least:
#    TOGETHER_API_KEY=your_key
#
# 3. Run from repo root:
#    npm run dev
#
# App URLs: http://localhost:3000  (marketing)
#           http://localhost:3000/app  (creator workspace)
#
# See apps/web/.env.example for the full variable list.
